<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://mediaplayer.local/MeuPlayer"
        version="2.0.0"
        viewmodes="maximized">

    <tizen:application id="MYpLyr0001.MeuPlayer"
                       package="MYpLyr0001"
                       required_version="2.4"/>

    <!-- IMPORTANTE: a TV Samsung rejeita a instalacao se <name> tiver espacos. -->
    <name>AmorecoFlix</name>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <access origin="*" subdomains="true"/>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="extensive"/>

    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>

    <!-- Privilegios (validos no perfil TV) -->
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:privilege name="http://tizen.org/privilege/content.read"/>
    <tizen:privilege name="http://tizen.org/privilege/content.write"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
    <tizen:privilege name="http://tizen.org/privilege/fullscreen"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>

</widget>
